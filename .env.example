# Copy this file to .env and fill in the values. Never commit .env.

# Instagram professional account ID (from GET /me?fields=user_id,username)
IG_USER_ID=

# Long-lived access token (60 days; the script auto-refreshes it after 45 days)
IG_ACCESS_TOKEN=

# Instagram Login (default):  graph.instagram.com
# Facebook Login:             graph.facebook.com
GRAPH_HOST=graph.instagram.com

# Leave empty for unversioned calls, or pin e.g. v23.0
GRAPH_VERSION=
